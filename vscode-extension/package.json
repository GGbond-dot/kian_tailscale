{
  "name": "kian-remote-lab",
  "displayName": "Kian Remote Lab",
  "description": "Manage DK2500 and the Desktop 5060 GPU node from VS Code.",
  "version": "0.2.0",
  "publisher": "kian-lab",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/GGbond-dot/kian_tailscale.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "keywords": ["ssh", "remote", "tailscale", "dk2500", "gpu", "wsl"],
  "main": "./extension.js",
  "extensionKind": ["ui"],
  "activationEvents": [
    "onView:kianRemoteLab.dashboard",
    "onCommand:kianRemoteLab.refresh",
    "onCommand:kianRemoteLab.openRemote",
    "onCommand:kianRemoteLab.openTerminal"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kianRemoteLab",
          "title": "Kian Remote Lab",
          "icon": "media/lab.svg"
        }
      ]
    },
    "views": {
      "kianRemoteLab": [
        {
          "id": "kianRemoteLab.dashboard",
          "name": "Lab Nodes",
          "type": "webview",
          "icon": "media/lab.svg",
          "contextualTitle": "Kian Remote Lab"
        }
      ]
    },
    "commands": [
      {
        "command": "kianRemoteLab.refresh",
        "title": "Refresh Lab Node Status",
        "category": "Kian Remote Lab",
        "icon": "$(refresh)"
      },
      {
        "command": "kianRemoteLab.openRemote",
        "title": "Open Lab Node in New Window",
        "category": "Kian Remote Lab",
        "icon": "$(remote)"
      },
      {
        "command": "kianRemoteLab.openTerminal",
        "title": "New Lab Node SSH Terminal",
        "category": "Kian Remote Lab",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kianRemoteLab.refresh",
          "when": "view == kianRemoteLab.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "kianRemoteLab.openTerminal",
          "when": "view == kianRemoteLab.dashboard",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "lint": "node --check extension.js && node --check devices.js && node --check tailscale.js",
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  }
}
